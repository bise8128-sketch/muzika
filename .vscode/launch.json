{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Next.js: Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3030",
            "webRoot": "${workspaceFolder}/audio-karaoke-app",
            "runtimeExecutable": "/home/k/.local/share/flatpak/exports/bin/com.google.Chrome",
            "userDataDir": "${workspaceFolder}/.vscode/chrome-debug-profile",
            "runtimeArgs": [
                "--remote-allow-origins=*",
                "--no-first-run",
                "--no-default-browser-check"
            ]
        },
        {
            "name": "Chrome: Attach",
            "type": "chrome",
            "request": "attach",
            "port": 9222,
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/audio-karaoke-app"
        },
        {
            "name": "Python: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "api:app",
                "--reload",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}/python-audio-cli",
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "Next.js: Server-side",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/audio-karaoke-app",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run-script", "dev:next-only"],
            "skipFiles": ["<node_internals>/**"]
        }
    ],
    "compounds": [
        {
            "name": "Full Stack Launch",
            "configurations": ["Next.js: Server-side", "Python: FastAPI", "Next.js: Chrome"]
        }
    ]
}