{
  "name": "audio-karaoke-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"NEXT,PYTHON\" -c \"cyan,green\" \"npm:dev:next\" \"npm:dev:python\"",
    "dev:next": "next dev --webpack --experimental-next-config-strip-types -p 3030",
    "dev:python": "bash ../python-audio-cli/start-backend.sh",
    "dev:next-only": "next dev --webpack --experimental-next-config-strip-types -p 3030",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit",
    "analyze": "cross-env ANALYZE=true next build"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@ffmpeg/core": "^0.12.6",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.1",
    "dexie": "^4.2.1",
    "music-metadata-browser": "^2.5.10",
    "next": "16.1.6",
    "next-intl": "^4.8.1",
    "onnxruntime-web": "^1.23.2",
    "pitch-shift": "^0.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "soundtouchjs": "^0.2.1",
    "tone": "^14.7.77",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "copy-webpack-plugin": "^12.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
